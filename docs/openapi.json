  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "resume_text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 10,
            "title": "Resume Text"
          },
          "job_description": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 10,
            "title": "Job Description"
          },
          "adult_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Adult Confirmed"
          },
          "processing_consent": {
            "type": "boolean",
            "const": true,
            "title": "Processing Consent"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/RequirementDecision"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Decisions"
          },
          "requirements_reviewed": {
            "type": "boolean",
            "title": "Requirements Reviewed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resume_text",
          "job_description",
          "adult_confirmed",
          "processing_consent"
        ],
        "title": "AnalyzeRequest"
      },
      "Body_import_pdf_v1_import_pdf_post": {
        "properties": {
