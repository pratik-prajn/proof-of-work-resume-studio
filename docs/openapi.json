        "required": [
          "file"
        ],
        "title": "Body_import_pdf_v1_import_pdf_post"
      },
      "Body_notebook_v1_evidence_notebook_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_notebook_v1_evidence_notebook_post"
      },
      "ExportRequest": {
        "properties": {
          "resume_text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 10,
            "title": "Resume Text"
          },
          "job_description": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 10,
            "title": "Job Description"
          },
          "adult_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Adult Confirmed"
          },
          "processing_consent": {
            "type": "boolean",
            "const": true,
            "title": "Processing Consent"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Hash"
          },
          "overrides": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 200,
            "title": "Overrides"
          },
          "template": {
            "type": "string",
            "enum": [
              "professional",
              "fresher"
            ],
            "title": "Template",
            "default": "professional"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resume_text",
          "job_description",
          "adult_confirmed",
          "processing_consent",
          "source_hash"
        ],
        "title": "ExportRequest"
      },
      "GuardRequest": {
        "properties": {
          "resume_text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 10,
            "title": "Resume Text"
          },
          "job_description": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 10,
            "title": "Job Description"
          },
          "adult_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Adult Confirmed"
          },
          "processing_consent": {
            "type": "boolean",
            "const": true,
            "title": "Processing Consent"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Hash"
          },
          "block_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Block Id"
          },
          "candidate": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Candidate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resume_text",
          "job_description",
          "adult_confirmed",
          "processing_consent",
          "source_hash",
          "block_id",
          "candidate"
        ],
        "title": "GuardRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InspectRepoRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 300,
            "title": "Url"
          },
          "adult_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Adult Confirmed"
          },
          "network_consent": {
            "type": "boolean",
            "const": true,
            "title": "Network Consent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "adult_confirmed",
          "network_consent"
        ],
        "title": "InspectRepoRequest"
      },
      "RequirementDecision": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "include",
              "exclude"
            ],
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 300,
            "title": "Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "decision"
        ],
        "title": "RequirementDecision"
      },
      "RewriteRequest": {
        "properties": {
          "resume_text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 10,
            "title": "Resume Text"
          },
          "job_description": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 10,
            "title": "Job Description"
          },
          "adult_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Adult Confirmed"
          },
          "processing_consent": {
            "type": "boolean",
            "const": true,
            "title": "Processing Consent"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Hash"
          },
          "use_llm": {
            "type": "boolean",
            "title": "Use Llm",
            "default": false
          },
          "llm_consent": {
            "type": "boolean",
            "title": "Llm Consent",
            "default": false
          }
